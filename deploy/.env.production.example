# =============================================================================
# Monevra — Template .env untuk SERVER PRODUKSI
#
# Cara pakai di server:
#   cp deploy/.env.production.example backend/.env
#   lalu EDIT semua nilai di bawah (jangan biarkan placeholder).
#
# JANGAN commit file .env yang sudah berisi nilai asli (sudah di-gitignore).
# =============================================================================

# WAJIB production — mengaktifkan fail-fast JWT, CSP ketat, error tanpa detail.
NODE_ENV=production

# Port backend (di belakang Nginx). Bebas, JANGAN bentrok.
PORT=3001

# ---- JWT ---------------------------------------------------------------------
# WAJIB. Acak >= 32 karakter (server MENOLAK start kalau lemah/kosong).
# Generate:  openssl rand -hex 48
JWT_SECRET=GANTI_DENGAN_OPENSSL_RAND_HEX_48

# ---- Database ----------------------------------------------------------------
# Buat user khusus (JANGAN root). Lihat DEPLOY.md bagian "Siapkan database".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=monevra_app
DB_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
DB_NAME=monevra

# ---- URL & CORS ---------------------------------------------------------------
# Domain PUBLIK backend (dipakai CORS whitelist + redirect OAuth).
# Beberapa domain dipisah koma. TANPA slash di akhir.
APP_URL=https://api.domainkamu.com

# ---- Google Gemini (scan struk AI) -------------------------------------------
GEMINI_API_KEY=GANTI_DENGAN_KEY_GEMINI

# ---- reCAPTCHA (WAJIB ganti dari key uji!) ------------------------------------
# Key uji Google (6LeIxAcTA...) SELALU lolos = tidak melindungi apa pun.
# Ambil key produksi: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=GANTI_DENGAN_RECAPTCHA_SECRET_PRODUKSI

# ---- SMTP (email reset password / verifikasi) --------------------------------
# Gmail: buat App Password (bukan password akun).
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=app_password_16_karakter

# ---- OAuth (login Google/GitHub) ---------------------------------------------
# Redirect URI di console OAuth HARUS:
#   https://api.domainkamu.com/auth/callback/google
#   https://api.domainkamu.com/auth/callback/github
GOOGLE_CLIENT_ID=GANTI
GOOGLE_CLIENT_SECRET=GANTI
GITHUB_CLIENT_ID=GANTI
GITHUB_CLIENT_SECRET=GANTI
