# Monevra Environment Configuration Example
# Salin file ini menjadi .env lalu isi nilai aslinya

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# App & Domain Settings (Untuk CORS & OAuth Redirect)
APP_URL=https://monevra.kroombox.com
FRONTEND_URL=https://monevra.kroombox.com
CORS_ORIGIN=https://monevra.kroombox.com

PORT=5008
NODE_ENV=production

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=monevra

# Kompatibilitas Database Ekstra
DB_CONNECTION=mysql
DB_DATABASE=monevra
DB_USERNAME=root
DB_PASS=your_db_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=monevra
MYSQL_USER=root
MYSQL_PASSWORD=your_db_password
DATABASE_URL=mysql://root:password@127.0.0.1:3306/monevra

# API & Security
VITE_API_URL=/api
JWT_SECRET=your_jwt_secret_min_32_characters_here

# SMTP (Email OTP / Reset Password)
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_app_password"

# Google OAuth 2.0
# Daftarkan di Google Cloud Console -> Authorized Redirect URIs:
# https://monevra.kroombox.com/auth/callback/google
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth
# Daftarkan callback di GitHub Developer Settings:
# https://monevra.kroombox.com/auth/callback/github
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Keamanan Tambahan & Layanan
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
OCR_SERVICE_URL=http://127.0.0.1:5001

# Storage
STORAGE_ROOT=../userdata
PAYMENT_PROOF_PATH=../user_billing
